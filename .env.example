# 프로덕션 환경변수 — .env로 복사 후 값 입력
# cp .env.example .env

# ─── 도메인 ───
DOMAIN=api.mf-game.com

# ─── MySQL 8.0 ───
DB_ROOT_PASSWORD=여기에_root_비밀번호
DB_PASSWORD=여기에_app_비밀번호
DB_NAME=mfg
DB_USER=mfg

# ─── Firebase ───
FIREBASE_PROJECT_ID=mfg-prod-4cb30
# 컨테이너 내부 경로. docker-compose.prod.yml에서 호스트 ./serviceAccountKey.json 을 마운트.
FIREBASE_CREDENTIAL_PATH=/app/serviceAccountKey.json

# ─── Google Play IAP 검증 ───
GOOGLE_PLAY_CREDENTIAL_PATH=/app/play-services.json
GOOGLE_PLAY_PACKAGE_NAME=com.mfg.game

# ─── Slack 알람 (S22-07, 선택) ───
# 비워 두면 알림 비활성. Slack Workspace → #mfg-errors 채널 Incoming Webhook URL.
# Error/Fatal 레벨만 전송되며 프로세스 로컬 rate limit 10/min 내장 (SlackWebhookSink.cs).
SLACK_WEBHOOK_ERRORS=

# ─── Cloudflare R2 (CF-03 완료 후 입력) ───
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=mfg-assets
R2_PUBLIC_URL=https://cdn.mf-game.com

# ─── 운영자 ───
ADMIN_EMAIL=admin@example.com

# ─── Admin 화이트리스트 (S261-04) ───
# /api/v1/admin/* 에 접근 가능한 user_id(또는 Firebase UID). 빈 리스트 = deny-by-default.
# ASP.NET Core Configuration 규칙: 배열 인덱스는 `__0`, `__1` … 로 주입.
# 예: Admin__AllowedUserIds__0=firebase-uid-admin1
Admin__AllowedUserIds__0=
# Admin__AllowedUserIds__1=
